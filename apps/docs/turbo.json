{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Astro writes the site to dist/, and starlight-typedoc regenerates
      // src/content/docs/api/** from the libraries' sources on every build (it
      // is gitignored for that reason).
      "outputs": ["dist/**", "src/content/docs/api/**"],
      // These mount the site under the aggregator's base path
      // (see astro.config.mjs) and change every emitted URL, so they belong in
      // the cache key. Without them a root-base build could replay for the
      // /packages/use-everywhere/ build in CI, and the breakage would stay
      // invisible until rxova.org served it.
      //
      // Declared here rather than on the root task so setting them does not also
      // invalidate the two library builds, which never read them.
      "env": ["DOCS_URL", "DOCS_BASE_URL"]
    },
    // These tests cover the agent-facing surfaces — the normalizer, the page
    // helpers, the llms.txt builders and the twin gate. No coverage report, so
    // the root task's `coverage/**` output would warn on every run; and no
    // `^build`, because every module under test is plain JavaScript over plain
    // objects. That is the whole reason they are split out from docs-md.mjs.
    "test": {
      "outputs": []
    }
  }
}
