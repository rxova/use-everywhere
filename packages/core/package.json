{
  "name": "@use-everywhere/core",
  "version": "0.6.0",
  "description": "Cross-tab shared state, events, presence, and cross-origin window channels",
  "license": "MIT",
  "author": "Jonatan Kruszewski <jonakrusze@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/use-everywhere.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/rxova/use-everywhere#readme",
  "bugs": "https://github.com/rxova/use-everywhere/issues",
  "keywords": [
    "broadcastchannel",
    "cross-tab",
    "shared-state",
    "postmessage",
    "cross-origin",
    "presence",
    "pubsub"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "check:exports": "publint --strict && attw --pack .",
    "pack:smoke": "node --import tsx ../tooling/pack-smoke.ts"
  },
  "size-limit": [
    {
      "name": "everything (import *)",
      "path": "dist/index.js",
      "import": "*",
      "limit": "6.1 kB"
    },
    {
      "name": "createLeader",
      "path": "dist/index.js",
      "import": "{ createLeader }",
      "limit": "2.85 kB"
    },
    {
      "name": "createSharedStore",
      "path": "dist/index.js",
      "import": "{ createSharedStore }",
      "limit": "2.8 kB"
    },
    {
      "name": "createChannel",
      "path": "dist/index.js",
      "import": "{ createChannel }",
      "limit": "1.8 kB"
    },
    {
      "name": "createPresence",
      "path": "dist/index.js",
      "import": "{ createPresence }",
      "limit": "1.9 kB"
    },
    {
      "name": "openWindow (opener side)",
      "path": "dist/index.js",
      "import": "{ openWindow }",
      "limit": "1.3 kB"
    },
    {
      "name": "connectToOpener (child side)",
      "path": "dist/index.js",
      "import": "{ connectToOpener }",
      "limit": "1.15 kB"
    },
    {
      "name": "observeBus + enableDebug",
      "path": "dist/index.js",
      "import": "{ observeBus, enableDebug }",
      "limit": "500 B"
    },
    {
      "name": "localStorageAdapter",
      "path": "dist/index.js",
      "import": "{ localStorageAdapter }",
      "limit": "500 B"
    },
    {
      "name": "MemoryHub (testing subpath)",
      "path": "dist/testing.js",
      "import": "{ MemoryHub }",
      "limit": "350 B"
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^13.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.11.1",
    "publint": "^0.3.21",
    "size-limit": "^13.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing.d.ts"
      ]
    }
  }
}
