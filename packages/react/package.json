{
  "name": "use-everywhere",
  "version": "0.7.0",
  "description": "React hooks for state and messages shared across tabs, windows, and workers",
  "license": "MIT",
  "author": "Jonatan Kruszewski <jonakrusze@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/use-everywhere.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/rxova/use-everywhere#readme",
  "bugs": "https://github.com/rxova/use-everywhere/issues",
  "keywords": [
    "react",
    "hooks",
    "broadcastchannel",
    "cross-tab",
    "shared-state",
    "postmessage",
    "cross-origin",
    "presence"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./devtools": {
      "import": {
        "types": "./dist/devtools/index.d.ts",
        "default": "./dist/devtools/index.js"
      },
      "require": {
        "types": "./dist/devtools/index.d.cts",
        "default": "./dist/devtools/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "check:exports": "publint --strict && attw --pack .",
    "pack:smoke": "node --import tsx ../tooling/pack-smoke.ts"
  },
  "size-limit": [
    {
      "name": "everything (import *)",
      "path": "dist/index.js",
      "import": "*",
      "limit": "8.92 kB"
    },
    {
      "name": "useSharedState",
      "path": "dist/index.js",
      "import": "{ useSharedState }",
      "limit": "3.89 kB"
    },
    {
      "name": "useChannel + useMessage + useSend",
      "path": "dist/index.js",
      "import": "{ useChannel, useMessage, useSend }",
      "limit": "2.39 kB"
    },
    {
      "name": "usePeers + useClientId",
      "path": "dist/index.js",
      "import": "{ usePeers, useClientId }",
      "limit": "2.57 kB"
    },
    {
      "name": "useOpenedWindow + openWindow",
      "path": "dist/index.js",
      "import": "{ useOpenedWindow, openWindow }",
      "limit": "1.76 kB"
    },
    {
      "name": "useLeader + useLeaderEffect",
      "path": "dist/index.js",
      "import": "{ useLeader, useLeaderEffect }",
      "limit": "3.84 kB"
    },
    {
      "name": "defineStore (persisted)",
      "path": "dist/index.js",
      "import": "{ defineStore, localStorageAdapter }",
      "limit": "4.38 kB"
    },
    {
      "name": "Inspector (devtools subpath)",
      "path": "dist/devtools/index.js",
      "import": "{ Inspector }",
      "limit": "5.81 kB"
    },
    {
      "name": "MemoryHub (testing subpath)",
      "path": "dist/testing.js",
      "import": "{ MemoryHub }",
      "limit": "400 B"
    }
  ],
  "dependencies": {
    "@use-everywhere/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^13.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.1",
    "publint": "^0.3.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "size-limit": "^13.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "typesVersions": {
    "*": {
      "devtools": [
        "./dist/devtools/index.d.ts"
      ],
      "testing": [
        "./dist/testing.d.ts"
      ]
    }
  }
}
