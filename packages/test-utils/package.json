{
  "name": "@use-everywhere/test-utils",
  "version": "1.0.1",
  "description": "Simulate several tabs in one process: a scenario DSL, an in-memory bus, fake windows and fake Web Locks",
  "license": "MIT",
  "author": "Jonatan Kruszewski <jonakrusze@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/use-everywhere.git",
    "directory": "packages/test-utils"
  },
  "homepage": "https://rxova.org/packages/use-everywhere/guides/testing/",
  "bugs": "https://github.com/rxova/use-everywhere/issues",
  "keywords": [
    "testing",
    "test-utils",
    "cross-tab",
    "multi-tab",
    "tabs",
    "broadcastchannel",
    "shared-state",
    "use-everywhere",
    "mock",
    "fake-timers",
    "cross-tab-state",
    "tab-synchronization",
    "multi-tab-testing",
    "vitest",
    "jest",
    "web-locks",
    "presence",
    "leader-election"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:exports": "publint --strict && attw --pack .",
    "pack:smoke": "node --import tsx ../tooling/pack-smoke.ts"
  },
  "dependencies": {
    "@use-everywhere/core": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@repo/config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.11",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
