{
  "name": "@use-everywhere/core",
  "version": "0.2.0",
  "description": "Cross-tab shared state, events, presence, and cross-origin window channels",
  "license": "MIT",
  "author": "Jonatan Kruszewski <jonakrusze@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/use-everywhere.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/rxova/use-everywhere#readme",
  "bugs": "https://github.com/rxova/use-everywhere/issues",
  "keywords": [
    "broadcastchannel",
    "cross-tab",
    "shared-state",
    "postmessage",
    "cross-origin",
    "presence",
    "pubsub"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "everything (import *)",
      "path": "dist/index.js",
      "import": "*",
      "limit": "3.5 kB"
    },
    {
      "name": "createSharedStore",
      "path": "dist/index.js",
      "import": "{ createSharedStore }",
      "limit": "1.3 kB"
    },
    {
      "name": "createChannel",
      "path": "dist/index.js",
      "import": "{ createChannel }",
      "limit": "900 B"
    },
    {
      "name": "createPresence",
      "path": "dist/index.js",
      "import": "{ createPresence }",
      "limit": "1 kB"
    },
    {
      "name": "openWindow (opener side)",
      "path": "dist/index.js",
      "import": "{ openWindow }",
      "limit": "1.15 kB"
    },
    {
      "name": "connectToOpener (child side)",
      "path": "dist/index.js",
      "import": "{ connectToOpener }",
      "limit": "1 kB"
    },
    {
      "name": "MemoryHub (test transport)",
      "path": "dist/index.js",
      "import": "{ MemoryHub }",
      "limit": "300 B"
    },
    {
      "name": "observeBus + enableDebug",
      "path": "dist/index.js",
      "import": "{ observeBus, enableDebug }",
      "limit": "500 B"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.10.6",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
