{
  "name": "use-everywhere",
  "version": "0.11.1",
  "description": "React hooks for state and messages shared across tabs, windows, and workers",
  "license": "MIT",
  "author": "Jonatan Kruszewski <jonakrusze@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/use-everywhere.git",
    "directory": "packages/react"
  },
  "homepage": "https://rxova.org/packages/use-everywhere/",
  "bugs": "https://github.com/rxova/use-everywhere/issues",
  "keywords": [
    "react",
    "hooks",
    "react-hooks",
    "broadcastchannel",
    "broadcast-channel",
    "cross-tab",
    "multi-tab",
    "tabs",
    "tab-sync",
    "sync",
    "shared-state",
    "state-management",
    "postmessage",
    "cross-origin",
    "cross-window",
    "presence",
    "leader-election",
    "cross-tab-state",
    "tab-synchronization",
    "broadcast",
    "pubsub",
    "web-locks",
    "sharedworker",
    "usestate",
    "shared-worker"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./dist/shared-worker.js",
    "./dist/shared-worker.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./devtools": {
      "import": {
        "types": "./dist/devtools/index.d.ts",
        "default": "./dist/devtools/index.js"
      },
      "require": {
        "types": "./dist/devtools/index.d.cts",
        "default": "./dist/devtools/index.cjs"
      }
    },
    "./shared-worker": {
      "import": {
        "types": "./dist/shared-worker.d.ts",
        "default": "./dist/shared-worker.js"
      },
      "require": {
        "types": "./dist/shared-worker.d.cts",
        "default": "./dist/shared-worker.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "check:exports": "publint --strict && attw --pack .",
    "pack:smoke": "node --import tsx ../tooling/pack-smoke.ts"
  },
  "size-limit": [
    {
      "name": "everything (import *)",
      "path": "dist/index.js",
      "import": "*",
      "limit": "10.89 kB"
    },
    {
      "name": "useSharedState",
      "path": "dist/index.js",
      "import": "{ useSharedState }",
      "limit": "4.24 kB"
    },
    {
      "name": "useSharedStore (selector)",
      "path": "dist/index.js",
      "import": "{ useSharedStore, shallowEqual }",
      "limit": "4.40 kB"
    },
    {
      "name": "useSharedReducer",
      "path": "dist/index.js",
      "import": "{ useSharedReducer }",
      "limit": "4.21 kB"
    },
    {
      "name": "useChannel + useMessage + useSend",
      "path": "dist/index.js",
      "import": "{ useChannel, useMessage, useSend }",
      "limit": "3.07 kB"
    },
    {
      "name": "usePeers + useClientId",
      "path": "dist/index.js",
      "import": "{ usePeers, useClientId }",
      "limit": "2.77 kB"
    },
    {
      "name": "useOpenedWindow + openWindow",
      "path": "dist/index.js",
      "import": "{ useOpenedWindow, openWindow }",
      "limit": "1.47 kB"
    },
    {
      "name": "useLeader + useLeaderEffect",
      "path": "dist/index.js",
      "import": "{ useLeader, useLeaderEffect }",
      "limit": "3.65 kB"
    },
    {
      "name": "defineStore (persisted)",
      "path": "dist/index.js",
      "import": "{ defineStore, localStorageAdapter }",
      "limit": "4.67 kB"
    },
    {
      "name": "Inspector (devtools subpath)",
      "path": "dist/devtools/index.js",
      "import": "{ Inspector }",
      "limit": "7.20 kB"
    },
    {
      "name": "SharedWorker relay (shared-worker subpath)",
      "path": "dist/shared-worker.js",
      "import": "*",
      "limit": "410 B"
    },
    {
      "name": "MemoryHub (testing subpath)",
      "path": "dist/testing.js",
      "import": "{ MemoryHub }",
      "limit": "264 B"
    }
  ],
  "dependencies": {
    "@use-everywhere/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^13.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.1",
    "publint": "^0.3.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "size-limit": "^13.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "typesVersions": {
    "*": {
      "devtools": [
        "./dist/devtools/index.d.ts"
      ],
      "shared-worker": [
        "./dist/shared-worker.d.ts"
      ],
      "testing": [
        "./dist/testing.d.ts"
      ]
    }
  }
}
