{
  "name": "@use-everywhere/core",
  "version": "1.0.3",
  "description": "Cross-tab shared state, events, presence, and cross-origin window channels",
  "license": "MIT",
  "author": "Jonatan Kruszewski <jonakrusze@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/use-everywhere.git",
    "directory": "packages/core"
  },
  "homepage": "https://rxova.dev/packages/use-everywhere/core/overview/",
  "bugs": "https://github.com/rxova/use-everywhere/issues",
  "keywords": [
    "broadcastchannel",
    "broadcast-channel",
    "cross-tab",
    "multi-tab",
    "tabs",
    "tab-sync",
    "sync",
    "shared-state",
    "state-management",
    "postmessage",
    "cross-origin",
    "cross-window",
    "presence",
    "leader-election",
    "pubsub",
    "cross-tab-state",
    "tab-synchronization",
    "broadcast",
    "web-locks",
    "sharedworker",
    "shared-worker",
    "vanilla-js",
    "zero-dependency"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./dist/shared-worker.js",
    "./dist/shared-worker.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./shared-worker": {
      "import": {
        "types": "./dist/shared-worker.d.ts",
        "default": "./dist/shared-worker.js"
      },
      "require": {
        "types": "./dist/shared-worker.d.cts",
        "default": "./dist/shared-worker.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "check:exports": "publint --strict && attw --pack .",
    "pack:smoke": "rxova-repo-config pack-smoke",
    "mutation": "stryker run && node --import tsx ../../scripts/mutation/check-mutation.ts reports/mutation/mutation.json"
  },
  "size-limit": [
    {
      "name": "everything (import *)",
      "path": "dist/index.js",
      "import": "*",
      "limit": "9.26 kB"
    },
    {
      "name": "createLeader",
      "path": "dist/index.js",
      "import": "{ createLeader }",
      "limit": "3.49 kB"
    },
    {
      "name": "createSharedStore",
      "path": "dist/index.js",
      "import": "{ createSharedStore }",
      "limit": "4.15 kB"
    },
    {
      "name": "createSharedReducer",
      "path": "dist/index.js",
      "import": "{ createSharedReducer }",
      "limit": "4.05 kB"
    },
    {
      "name": "createChannel",
      "path": "dist/index.js",
      "import": "{ createChannel }",
      "limit": "3.02 kB"
    },
    {
      "name": "createPresence",
      "path": "dist/index.js",
      "import": "{ createPresence }",
      "limit": "2.75 kB"
    },
    {
      "name": "openWindow (opener side)",
      "path": "dist/index.js",
      "import": "{ openWindow }",
      "limit": "1.52 kB"
    },
    {
      "name": "connectToOpener (child side)",
      "path": "dist/index.js",
      "import": "{ connectToOpener }",
      "limit": "1.37 kB"
    },
    {
      "name": "observeBus + enableDebug",
      "path": "dist/index.js",
      "import": "{ observeBus, enableDebug }",
      "limit": "600 B"
    },
    {
      "name": "localStorageAdapter",
      "path": "dist/index.js",
      "import": "{ localStorageAdapter }",
      "limit": "935 B"
    },
    {
      "name": "indexedDbAdapter",
      "path": "dist/index.js",
      "import": "{ indexedDbAdapter }",
      "limit": "735 B"
    },
    {
      "name": "SharedWorkerTransport",
      "path": "dist/index.js",
      "import": "{ SharedWorkerTransport }",
      "limit": "640 B"
    },
    {
      "name": "SharedWorker relay (shared-worker subpath)",
      "path": "dist/shared-worker.js",
      "import": "*",
      "limit": "440 B"
    },
    {
      "name": "MemoryHub (testing subpath)",
      "path": "dist/testing.js",
      "import": "{ MemoryHub }",
      "limit": "267 B"
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.11.15",
    "publint": "^0.3.24",
    "size-limit": "^14.1.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "typesVersions": {
    "*": {
      "shared-worker": [
        "./dist/shared-worker.d.ts"
      ],
      "testing": [
        "./dist/testing.d.ts"
      ]
    }
  }
}
