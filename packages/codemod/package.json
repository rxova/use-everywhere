{
  "name": "use-everywhere-codemod",
  "version": "0.0.0",
  "description": "Codemod for the use-everywhere 1.0 renames: rewrites the 0.x names to their 1.0 spellings",
  "license": "MIT",
  "author": "Jonatan Kruszewski <jonakrusze@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/use-everywhere.git",
    "directory": "packages/codemod"
  },
  "homepage": "https://rxova.org/packages/use-everywhere/guides/migration/",
  "bugs": "https://github.com/rxova/use-everywhere/issues",
  "keywords": [
    "use-everywhere",
    "codemod",
    "migration",
    "rename",
    "cross-tab",
    "react-hooks",
    "shared-state"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "use-everywhere-codemod": "./bin/use-everywhere-codemod.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "bin",
    "dist",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:exports": "publint --strict && attw --pack .",
    "pack:smoke": "node --import tsx ../tooling/pack-smoke.ts"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
