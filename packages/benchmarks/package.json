{
  "name": "@use-everywhere/benchmarks",
  "version": "0.0.0",
  "private": true,
  "description": "What the library costs over a raw BroadcastChannel, measured",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bench": "node --import tsx ./src/run.ts",
    "bench:check": "node --import tsx ./src/run.ts --check",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@use-everywhere/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "broadcast-channel": "^7.4.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
