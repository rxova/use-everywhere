{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json", ".nvmrc"],
  "globalPassThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      // A library build only reads src + build config. Excluding tests, e2e and
      // docs-adjacent files keeps editing them from busting the build cache —
      // they cannot affect dist. $TURBO_DEFAULT$ keeps the normal file set.
      "inputs": [
        "$TURBO_DEFAULT$",
        "!e2e/**",
        "!**/__tests__/**",
        "!**/*.test.*",
        "!README.md",
        "!CHANGELOG.md"
      ],
      "outputLogs": "new-only"
    },
    // `^build` on all three: dependents typecheck, test and measure against the
    // libraries' emitted .d.ts and dist, which is why every CI job used to open
    // with an explicit `pnpm --filter core --filter use-everywhere build`.
    // Declaring it here means a package added later inherits the guarantee
    // instead of silently running against stale or absent output.
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "outputLogs": "new-only"
    },
    // These three read the package's own dist, not its dependencies' —
    // `build`, not `^build`. Declaring the dependency centrally means a package
    // added later inherits it instead of silently running against stale or
    // absent output.
    "size": {
      "dependsOn": ["build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    // publint and attw read the manifest and the emitted types. Cheap enough to
    // batch with the rest.
    "check:exports": {
      "dependsOn": ["build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    // Packs the real tarball, installs it into a scratch project and imports it
    // through both module systems — the only check that catches a `files` entry
    // that dropped dist, or an exports map that resolves for a bundler but not
    // for plain Node. The root script serialises it with --concurrency=1:
    // concurrent `pnpm pack` invocations race on the store.
    //
    // Keyed on the shared script as well as the package, so editing the checker
    // invalidates the cache instead of replaying an old pass.
    "pack:smoke": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/tooling/pack-smoke.ts"],
      "outputLogs": "new-only"
    },
    // A root task (`//#`): `pnpm dedupe --check` reads the whole workspace in one
    // pass from the root, so there is nothing to fan out. It is a pure function
    // of the dependency graph, so keying the cache on exactly the files that feed
    // it means source edits replay it while any manifest change re-runs it.
    //
    // Deliberately NOT applied to audit:check: its result depends on the upstream
    // advisory database, which changes without any file here changing, so a
    // cached pass could replay over a newly-disclosed CVE.
    "//#dedupe:check": {
      "outputs": [],
      "inputs": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "package.json",
        "packages/*/package.json",
        "apps/*/package.json"
      ],
      "outputLogs": "new-only"
    },
    // No `e2e` task: Playwright is configured once at the repo root
    // (playwright.config.ts, testDir ./e2e) rather than per package, so there is
    // nothing to fan out. The root `e2e` script builds the published packages through
    // Turbo first — the demo app the webServer serves imports them — and then
    // shells out to playwright directly. It is never cacheable anyway: it drives
    // a real browser against a dev server it starts itself.
    // Minutes long, so it is never part of `verify` — CI runs it as its own
    // job. Depends on ^build like `test` does, for the same reason.
    "mutation": {
      "dependsOn": ["^build"],
      "outputs": ["reports/**"],
      "outputLogs": "new-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
