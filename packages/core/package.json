{
  "name": "@use-everywhere/core",
  "version": "0.11.2",
  "description": "Cross-tab shared state, events, presence, and cross-origin window channels",
  "license": "MIT",
  "author": "Jonatan Kruszewski <jonakrusze@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/use-everywhere.git",
    "directory": "packages/core"
  },
  "homepage": "https://rxova.org/packages/use-everywhere/core/overview/",
  "bugs": "https://github.com/rxova/use-everywhere/issues",
  "keywords": [
    "broadcastchannel",
    "broadcast-channel",
    "cross-tab",
    "multi-tab",
    "tabs",
    "tab-sync",
    "sync",
    "shared-state",
    "state-management",
    "postmessage",
    "cross-origin",
    "cross-window",
    "presence",
    "leader-election",
    "pubsub",
    "cross-tab-state",
    "tab-synchronization",
    "broadcast",
    "web-locks",
    "sharedworker",
    "shared-worker",
    "vanilla-js",
    "zero-dependency"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./dist/shared-worker.js",
    "./dist/shared-worker.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./shared-worker": {
      "import": {
        "types": "./dist/shared-worker.d.ts",
        "default": "./dist/shared-worker.js"
      },
      "require": {
        "types": "./dist/shared-worker.d.cts",
        "default": "./dist/shared-worker.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "check:exports": "publint --strict && attw --pack .",
    "pack:smoke": "node --import tsx ../tooling/pack-smoke.ts",
    "mutation": "stryker run && node --import tsx ../tooling/check-mutation.ts reports/mutation/mutation.json"
  },
  "size-limit": [
    {
      "name": "everything (import *)",
      "path": "dist/index.js",
      "import": "*",
      "limit": "8.78 kB"
    },
    {
      "name": "createLeader",
      "path": "dist/index.js",
      "import": "{ createLeader }",
      "limit": "3.23 kB"
    },
    {
      "name": "createSharedStore",
      "path": "dist/index.js",
      "import": "{ createSharedStore }",
      "limit": "3.90 kB"
    },
    {
      "name": "createSharedReducer",
      "path": "dist/index.js",
      "import": "{ createSharedReducer }",
      "limit": "3.79 kB"
    },
    {
      "name": "createChannel",
      "path": "dist/index.js",
      "import": "{ createChannel }",
      "limit": "2.74 kB"
    },
    {
      "name": "createPresence",
      "path": "dist/index.js",
      "import": "{ createPresence }",
      "limit": "2.47 kB"
    },
    {
      "name": "openWindow (opener side)",
      "path": "dist/index.js",
      "import": "{ openWindow }",
      "limit": "1.23 kB"
    },
    {
      "name": "connectToOpener (child side)",
      "path": "dist/index.js",
      "import": "{ connectToOpener }",
      "limit": "1.09 kB"
    },
    {
      "name": "observeBus + enableDebug",
      "path": "dist/index.js",
      "import": "{ observeBus, enableDebug }",
      "limit": "316 B"
    },
    {
      "name": "localStorageAdapter",
      "path": "dist/index.js",
      "import": "{ localStorageAdapter }",
      "limit": "655 B"
    },
    {
      "name": "indexedDbAdapter",
      "path": "dist/index.js",
      "import": "{ indexedDbAdapter }",
      "limit": "447 B"
    },
    {
      "name": "SharedWorkerTransport",
      "path": "dist/index.js",
      "import": "{ SharedWorkerTransport }",
      "limit": "380 B"
    },
    {
      "name": "SharedWorker relay (shared-worker subpath)",
      "path": "dist/shared-worker.js",
      "import": "*",
      "limit": "410 B"
    },
    {
      "name": "MemoryHub (testing subpath)",
      "path": "dist/testing.js",
      "import": "{ MemoryHub }",
      "limit": "267 B"
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^13.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.11.1",
    "publint": "^0.3.21",
    "size-limit": "^13.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "typesVersions": {
    "*": {
      "shared-worker": [
        "./dist/shared-worker.d.ts"
      ],
      "testing": [
        "./dist/testing.d.ts"
      ]
    }
  }
}
