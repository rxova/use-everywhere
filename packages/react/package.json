{
  "name": "use-everywhere",
  "version": "0.2.0",
  "description": "React hooks for state and messages shared across tabs, windows, and workers",
  "license": "MIT",
  "author": "Jonatan Kruszewski <jonakrusze@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/use-everywhere.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/rxova/use-everywhere#readme",
  "bugs": "https://github.com/rxova/use-everywhere/issues",
  "keywords": [
    "react",
    "hooks",
    "broadcastchannel",
    "cross-tab",
    "shared-state",
    "postmessage",
    "cross-origin",
    "presence"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "everything (import *)",
      "path": "dist/index.js",
      "import": "*",
      "limit": "5.4 kB"
    },
    {
      "name": "useSharedState",
      "path": "dist/index.js",
      "import": "{ useSharedState }",
      "limit": "1.8 kB"
    },
    {
      "name": "useChannel + useMessage + useSend",
      "path": "dist/index.js",
      "import": "{ useChannel, useMessage, useSend }",
      "limit": "1 kB"
    },
    {
      "name": "usePeers + useClientId",
      "path": "dist/index.js",
      "import": "{ usePeers, useClientId }",
      "limit": "1.1 kB"
    },
    {
      "name": "useOpenedWindow + openWindow",
      "path": "dist/index.js",
      "import": "{ useOpenedWindow, openWindow }",
      "limit": "1.4 kB"
    },
    {
      "name": "useLeader + useLeaderEffect",
      "path": "dist/index.js",
      "import": "{ useLeader, useLeaderEffect }",
      "limit": "1.8 kB"
    },
    {
      "name": "defineStore (persisted)",
      "path": "dist/index.js",
      "import": "{ defineStore, localStorageAdapter }",
      "limit": "2.3 kB"
    }
  ],
  "dependencies": {
    "@use-everywhere/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.10.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
